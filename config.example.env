# Copy to config.local.env on each Mac. This is a trusted local shell config.
# Work Mac: role=work; home Mac: role=home. Keep the two configurations separate.
ORCA_RELAY_ROLE=work
ORCA_APP_PATH='/Applications/Orca.app'

# Work Mac: run ./work-tunnel environments, then fill in the selected environment ID.
ORCA_ENVIRONMENT_ID=''
ORCA_RELAY_WORK_TARGET=orca-cloud-work
ORCA_RELAY_BACKUP_PORT=17668

# Home Mac: use your own relay server and verified known_hosts.local file.
ORCA_RELAY_HOST=relay.example.com
ORCA_RELAY_SSH_PORT=22
ORCA_RELAY_HOME_USER=orca-home-relay
ORCA_RELAY_REMOTE_PORT=16768
ORCA_RELAY_ORCA_PORT=6768
# ORCA_RELAY_KNOWN_HOSTS_FILE='/absolute/path/to/verified/known_hosts'
# ORCA_RELAY_STATE_DIR="$HOME/Library/Application Support/Orca SSH Relay"
